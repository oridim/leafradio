{
    "name": "leafradio",
    "version": "0.0.6",
    "license": "MIT",

    "compilerOptions": {
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["@types/meyda"]
    },

    "compile": {
        "include": [
            "lib/workers/worker-runner.ts",
            "shared/workers/audio-processing-worker.ts",
            "shared/workers/hash-worker.ts"
        ]
    },

    "fmt": {
        "include": ["./"],

        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 4,
        "singleQuote": true,
        "proseWrap": "preserve"
    },

    "include": ["./**/*.ts"],

    "lint": {
        "include": ["./"],
        "exclude": ["./vendor"],

        "rules": {
            "tags": ["recommended"]
        }
    },

    "imports": {
        "@/": "./",
        "@cfworker/json-schema": "npm:@cfworker/json-schema@^4.1.1",
        "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
        "@drizzle-team/brocli": "npm:@drizzle-team/brocli@^0.12.0",
        "@std/collections": "jsr:@std/collections@^1.2.0",
        "@std/crypto": "jsr:@std/crypto@^1.1.0",
        "@std/csv": "jsr:@std/csv@^1.0.6",
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@std/path": "jsr:@std/path@^1.1.5",
        "@std/streams": "jsr:@std/streams@^1.1.1",
        "audio": "npm:audio@^2.6.8",
        "consola": "npm:consola@^3.4.2",
        "json-schema-to-ts": "npm:json-schema-to-ts@^3.1.1",
        "m3u-parser-generator": "npm:m3u-parser-generator@^5.0.2",
        "meyda": "npm:meyda@^5.6.3",
        "ohash": "npm:ohash@^2.0.11",
        "pure-rand": "npm:pure-rand@^8.4.0"
    },

    "exports": {},

    "nodeModulesDir": "auto",

    "tasks": {
        "check": "deno task check:format;deno task check:types;deno task check:lint",
        "check:format": "deno fmt --check ./",
        "check:lint": "deno lint ./",
        "check:types": "deno check ./",
        "cli:compile": "deno compile --allow-read --allow-write --allow-net --allow-run --allow-env --allow-ffi $COMPILE_FLAGS ./cli/mod.ts",
        "cli:compile:linux:x86_64": "COMPILE_FLAGS=\"--output ./dist/leafradio.x86_64-unknown-linux-gnu --target x86_64-unknown-linux-gnu\" deno task cli:compile",
        "cli:compile:macos:x86_64": "COMPILE_FLAGS=\"--output ./dist/leafradio.x86_64-apple-darwin --target x86_64-apple-darwin\" deno task cli:compile",
        "cli:compile:windows:x86_64": "COMPILE_FLAGS=\"--output ./dist/leafradio.x86_64-pc-windows-msvc.exe --target x86_64-pc-windows-msvc\" deno task cli:compile",
        "cli:run": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env --allow-ffi ./cli/mod.ts",
        "deps:cache": "deno cache ./cli/mod.ts",
        "format": "deno fmt ./",
        "serve:run": "deno task cli:run serve"
    }
}
