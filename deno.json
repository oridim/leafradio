{
    "name": "leafradio",
    "version": "0.0.1",
    "license": "MIT",

    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@oridim/datastar-serve",
        "jsxImportSourceTypes": "@oridim/datastar-serve",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["@types/meyda"]
    },

    "compile": {
        "include": [
            "lib/workers/worker-runner.ts",
            "shared/workers/audio-processing-worker.ts",
            "shared/workers/hash-worker.ts"
        ]
    },

    "fmt": {
        "include": ["./"],

        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 4,
        "singleQuote": true,
        "proseWrap": "preserve"
    },

    "include": ["./**/*.ts"],

    "lint": {
        "include": ["./"],

        "rules": {
            "tags": ["recommended"]
        }
    },

    "imports": {
        "@/": "./",
        "@404wolf/xdg-portable": "jsr:@404wolf/xdg-portable@^0.1.0",
        "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
        "@drizzle-team/brocli": "npm:@drizzle-team/brocli@^0.12.0",
        "@mikro-orm/cli": "npm:@mikro-orm/cli@^7.1.3",
        "@mikro-orm/core": "npm:@mikro-orm/core@^7.1.3",
        "@mikro-orm/migrations": "npm:@mikro-orm/migrations@^7.1.3",
        "@mikro-orm/sql": "npm:@mikro-orm/sql@^7.1.3",
        "@std/collections": "jsr:@std/collections@^1.2.0",
        "@std/crypto": "jsr:@std/crypto@^1.1.0",
        "@std/csv": "jsr:@std/csv@^1.0.6",
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@std/media-types": "jsr:@std/media-types@^1.1.0",
        "@std/path": "jsr:@std/path@^1.1.5",
        "@std/streams": "jsr:@std/streams@^1.1.1",
        "beat-detection": "npm:beat-detection@^1.1.0",
        "consola": "npm:consola@^3.4.2",
        "kysely": "npm:kysely@^0.29.2",
        "m3u-parser-generator": "npm:m3u-parser-generator@^5.0.2",
        "meyda": "npm:meyda@^5.6.3",
        "ohash": "npm:ohash@^2.0.11",
        "pure-rand": "npm:pure-rand@^8.4.0"
    },

    "exports": {},

    "nodeModulesDir": "auto",

    "tasks": {
        "cli:compile": "deno compile --allow-read --allow-write --allow-net --allow-run --allow-env --allow-ffi",
        "cli:compile:linux:x86_64": "deno task cli:compile --output ./dist/leafradio.x86_64-unknown-linux ./cli/mod.ts",
        "cli:run": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env --allow-ffi ./cli/mod.ts",
        "mikro-orm:cli": "MIKRO_ORM_CLI_CONFIG=./shared/configuration/database.ts deno run -A npm:@mikro-orm/cli",
        "migrations:generate": "deno task mikro-orm:cli migration:create",
        "serve:run": "deno task cli:run serve"
    }
}
